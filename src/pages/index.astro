---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllGames } from '../lib/games';
import { getAllCategories } from '../lib/categories';
import { getAllPublishers } from '../lib/publishers';

export const prerender = true;

const games = await getAllGames(getDatabase());
const categories = await getAllCategories(getDatabase());
const publishers = await getAllPublishers(getDatabase());
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <div class="flex flex-col gap-4 mb-6 sm:flex-row sm:items-end sm:justify-between">
        <h2 class="text-2xl font-medium text-slate-100">Featured Games</h2>
        <p id="filter-results" class="text-sm text-slate-400" role="status" aria-live="polite">
          Showing {games.length} {games.length === 1 ? 'game' : 'games'}
        </p>
      </div>

      <form id="game-filters" class="mb-8 rounded-xl border border-slate-700 bg-slate-800/60 p-6" data-testid="game-filters">
        <div class="grid gap-6 lg:grid-cols-2">
          <fieldset>
            <legend class="mb-3 text-sm font-semibold text-slate-100">Filter by category</legend>
            <div class="grid gap-2 sm:grid-cols-2">
              {categories.map((category) => (
                <label class="flex items-center gap-2 text-sm text-slate-300" data-testid={`category-filter-${category.id}`}>
                  <input
                    type="checkbox"
                    name="category"
                    value={category.id}
                    class="h-4 w-4 rounded border-slate-600 bg-slate-900 text-blue-500 focus:ring-2 focus:ring-blue-500"
                    data-testid={`category-filter-input-${category.id}`}
                  />
                  <span>{category.name}</span>
                </label>
              ))}
            </div>
          </fieldset>

          <div>
            <label for="publisher-filter" class="mb-3 block text-sm font-semibold text-slate-100">Filter by publisher</label>
            <select
              id="publisher-filter"
              name="publisher"
              class="w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus:ring-2 focus:ring-blue-500 focus:outline-none"
              data-testid="publisher-filter"
            >
              <option value="">All publishers</option>
              {publishers.map((publisher) => <option value={publisher.id}>{publisher.name}</option>)}
            </select>
          </div>
        </div>

        <button
          type="reset"
          class="mt-6 rounded-lg border border-slate-600 px-4 py-2 text-sm font-medium text-slate-200 transition-colors hover:bg-slate-700 focus:ring-2 focus:ring-blue-500 focus:outline-none"
          data-testid="clear-filters"
        >
          Clear filters
        </button>
      </form>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <div id="games-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-testid="games-grid">
          {games.map((game) => <GameCard game={game} />)}
        </div>
      )}
      <div id="filtered-empty-state" class="hidden" data-testid="filtered-empty-state">
        <EmptyState text="No games match the selected filters." />
      </div>
    </div>
  </div>
</Layout>

<script>
  const filterForm = document.querySelector<HTMLFormElement>('#game-filters');
  const gameCards = Array.from(document.querySelectorAll<HTMLElement>('[data-testid="game-card"]'));
  const results = document.querySelector<HTMLElement>('#filter-results');
  const emptyState = document.querySelector<HTMLElement>('#filtered-empty-state');

  if (filterForm && results && emptyState) {
    const updateGames = (): void => {
      const selectedCategories = new Set(
        Array.from(filterForm.querySelectorAll<HTMLInputElement>('input[name="category"]:checked'))
          .map((input) => input.value),
      );
      const selectedPublisher = filterForm.querySelector<HTMLSelectElement>('select[name="publisher"]')?.value ?? '';
      let visibleCount = 0;

      for (const card of gameCards) {
        const categoryId = card.dataset.categoryId ?? '';
        const publisherId = card.dataset.publisherId ?? '';
        const categoryMatches = selectedCategories.size === 0 || selectedCategories.has(categoryId);
        const publisherMatches = selectedPublisher === '' || selectedPublisher === publisherId;
        const isVisible = categoryMatches && publisherMatches;

        card.hidden = !isVisible;
        card.setAttribute('aria-hidden', String(!isVisible));
        if (isVisible) visibleCount++;
      }

      results.textContent = `Showing ${visibleCount} ${visibleCount === 1 ? 'game' : 'games'}`;
      emptyState.classList.toggle('hidden', visibleCount !== 0);
    };

    filterForm.addEventListener('change', updateGames);
    filterForm.addEventListener('reset', () => requestAnimationFrame(updateGames));
  }
</script>
